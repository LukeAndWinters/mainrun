#!/usr/bin/env bash
set -euo pipefail
# Block staged changes that set epochs != 7 (simple heuristic)
if git diff --staged -U0 -- mainrun/train.py | grep -E '\+.*epochs\s*=\s*[^7]'; then
  echo "[HOOK] epochs != 7 detected in staged changes"; exit 1
fi
# Run Python guard with placeholders (full check runs at train-time)
python3 mainrun/rules/check_rules.py --precommit